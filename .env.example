# --- Database (docker-compose defaults) ---
DATABASE_URL=postgresql://workshop:workshop@localhost:5432/ai_workshop?schema=public

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- Auth (shared between web and api; generate with: openssl rand -base64 32) ---
AUTH_SECRET=

# --- AI providers (server-side only; never prefix with NEXT_PUBLIC_) ---
ANTHROPIC_API_KEY=
AI_DEFAULT_PROVIDER=mock
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

# --- API ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# --- Gemini (alternative provider; set AI_DEFAULT_PROVIDER=gemini to use) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated backups, tried in order when the main model is busy
GEMINI_FALLBACK_MODELS=gemini-3.7-flash-08-2026

# --- OpenAI-compatible provider (resellers and gateways that use /chat/completions) ---
# Set AI_DEFAULT_PROVIDER=openai-compatible to use these.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- Login Google (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type Web) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# --- Hosted database examples (replace DATABASE_URL and DIRECT_URL together) ---
# Neon: DATABASE_URL = pooled string (host contains -pooler), DIRECT_URL = same without -pooler
#   DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#   DIRECT_URL=postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
# Supabase: DATABASE_URL = transaction pooler (port 6543), DIRECT_URL = direct connection (port 5432)
#   DATABASE_URL=postgresql://postgres.REF:PASS@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   DIRECT_URL=postgresql://postgres.REF:PASS@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Email (kode verifikasi daftar). Resend: https://resend.com ---
# Tanpa key ini, di development kode tampil di console API. Di production wajib diisi.
RESEND_API_KEY=
# Untuk tes awal, Resend mengizinkan pengirim onboarding@resend.dev, tapi hanya ke email akun Resend Anda.
MAIL_FROM=Winterlie <onboarding@resend.dev>
